# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-your-token
# Юзернейм бота без @
BOT_USERNAME=tots_bot
# Короткое имя Mini App из BotFather (/newapp). Оставьте пустым, если используете
# «главное» мини-приложение бота (BotFather → Bot Settings → Configure Mini App)
WEBAPP_SHORT_NAME=tots
# Публичный HTTPS-адрес, где открыт этот сервер (он же URL мини-приложения)
WEBAPP_URL=https://tots.example.com
# Порт веб-сервера
PORT=8080
# Сколько бистов выдаётся при регистрации
START_BALANCE=10
# Путь к базе
DB_PATH=tots.db
